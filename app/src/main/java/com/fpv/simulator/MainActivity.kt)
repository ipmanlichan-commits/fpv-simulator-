// --- ИНТЕРФЕЙС И ЭКРАНЫ ---

@Composable
fun MainSimulatorScreen() {
    var droneX by remember { mutableDoubleStateOf(3000.0) }
    var droneY by remember { mutableDoubleStateOf(4000.0) }
    val droneZ = 300.0

    val stationPos = remember { Position3D(0.0, 0.0, 2.0) }
    val rotatorController = remember { AntennaRotatorController() }

    var joystickX by remember { mutableFloatStateOf(0f) }
    var joystickY by remember { mutableFloatStateOf(0f) }

    val currentSignal = remember(droneX, droneY, rotatorController.state) {
        RssiCalculator.calculateSignal(
            dronePos = Position3D(droneX, droneY, droneZ),
            stationPos = stationPos,
            antennaAzimuthDeg = rotatorController.state.azimuthDeg.toDouble(),
            antennaElevationDeg = rotatorController.state.elevationDeg.toDouble()
        )
    }

    LaunchedEffect(Unit) {
        var lastTime = System.nanoTime()
        while (true) {
            withFrameNanos { now ->
                val dt = (now - lastTime) / 1_000_000_000f
                lastTime = now

                if (joystickX != 0f || joystickY != 0f) {
                    rotatorController.update(joystickX, joystickY, dt)
                }

                val timeSec = now / 1_000_000_000.0
                droneX = 4000.0 * cos(timeSec * 0.1)
                droneY = 4000.0 * sin(timeSec * 0.1)
            }
        }
    }

    Column(modifier = Modifier.fillMaxSize()) {
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .weight(1f)
        ) {
            Box(
                modifier = Modifier
                    .weight(1f)
                    .fillMaxHeight()
                    .padding(4.dp)
                    .border(1.dp, Color(0xFF334155), RoundedCornerShape(8.dp))
            ) {
                FpvMonitorScreen(rssiDbm = currentSignal.rssiDbm, altitude = droneZ)
            }

            Box(
                modifier = Modifier
                    .weight(1f)
                    .fillMaxHeight()
                    .padding(4.dp)
                    .border(1.dp, Color(0xFF334155), RoundedCornerShape(8.dp))
                    .background(Color(0xFF1E293B)),
                contentAlignment = Alignment.Center
            ) {
                Text(
                    text = String.format(Locale.US, "КАРТА\n\nДистанция: %.2f км\nИст. Азимут: %03d°\nИст. Угол: %02d°",
                        currentSignal.distanceMeters / 1000.0,
                        currentSignal.targetAzimuthDeg.toInt(),
                        currentSignal.targetElevationDeg.toInt()
                    ),
                    color = Color.White,
                    fontSize = 16.sp,
                    fontFamily = FontFamily.Monospace
                )
            }
        }

        Surface(
            modifier = Modifier
                .fillMaxWidth()
                .height(160.dp),
            color = Color(0xFF111827)
        ) {
            Row(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(12.dp),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                ComposableLcdScreen(
                    azimuth = rotatorController.state.azimuthDeg,
                    elevation = rotatorController.state.elevationDeg,
                    voltage = rotatorController.state.batteryVoltage,
                    modifier = Modifier
                        .width(240.dp)
                        .fillMaxHeight()
                )

                VirtualJoystick(
                    sizeDp = 130.dp,
                    knobSizeDp = 45.dp,
                    onMove = { x, y ->
                        joystickX = x
                        joystickY = y
                    }
                )
            }
        }
    }
}

@Composable
fun FpvMonitorScreen(rssiDbm: Double, altitude: Double) {
    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(Color.Black)
    ) {
        val noiseAlpha = when {
            rssiDbm > -65 -> 0.0f
            rssiDbm in -85.0..-65.0 -> ((-65.0 - rssiDbm) / 20.0).toFloat() * 0.5f
            rssiDbm in -95.0..-85.0 -> 0.5f + ((-85.0 - rssiDbm) / 10.0).toFloat() * 0.4f
            else -> 0.98f
        }

        Text(
            text = "ALT: ${altitude.toInt()}M\nRSSI: ${rssiDbm.toInt()} dBm",
            color = Color.Green,
            fontFamily = FontFamily.Monospace,
            fontSize = 14.sp,
            modifier = Modifier
                .align(Alignment.TopStart)
                .padding(8.dp)
        )

        if (noiseAlpha > 0f) {
            Canvas(modifier = Modifier.fillMaxSize()) {
                val w = size.width.toInt()
                val h = size.height.toInt()
                for (i in 0..100) {
                    val rx = Random.nextInt(0, max(w, 1)).toFloat()
                    val ry = Random.nextInt(0, max(h, 1)).toFloat()
                    drawRect(
                        color = Color.White.copy(alpha = noiseAlpha * Random.nextFloat()),
                        topLeft = Offset(rx, ry),
                        size = androidx.compose.ui.geometry.Size(Random.nextInt(10, 80).toFloat(), 2f)
                    )
                }
            }
        }
    }
}

