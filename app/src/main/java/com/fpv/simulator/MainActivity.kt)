// --- МОДЕЛИ ДАННЫХ И ФИЗИКА ---

data class Position3D(val x: Double, val y: Double, val z: Double)

data class SignalResult(
    val distanceMeters: Double,
    val targetAzimuthDeg: Double,
    val targetElevationDeg: Double,
    val deltaAzimuthDeg: Double,
    val deltaElevationDeg: Double,
    val rssiDbm: Double
)

object RssiCalculator {
    fun calculateSignal(
        dronePos: Position3D,
        stationPos: Position3D,
        antennaAzimuthDeg: Double,
        antennaElevationDeg: Double,
        pTxDbm: Double = 30.0,
        gMaxDbi: Double = 14.0,
        beamwidthH: Double = 30.0,
        beamwidthV: Double = 20.0,
        freqMhz: Double = 5800.0
    ): SignalResult {
        val dx = dronePos.x - stationPos.x
        val dy = dronePos.y - stationPos.y
        val dz = dronePos.z - stationPos.z

        val distance = max(sqrt(dx * dx + dy * dy + dz * dz), 1.0)
        val horizDist = sqrt(dx * dx + dy * dy)

        val targetAzRad = atan2(dx, dy)
        val targetAzDeg = (Math.toDegrees(targetAzRad) + 360) % 360

        val targetElRad = atan2(dz, horizDist)
        val targetElDeg = Math.toDegrees(targetElRad)

        val deltaAz = (targetAzDeg - antennaAzimuthDeg + 180) % 360 - 180
        val deltaEl = targetElDeg - antennaElevationDeg

        val lossAz = 12.0 * (deltaAz / beamwidthH).pow(2)
        val lossEl = 12.0 * (deltaEl / beamwidthV).pow(2)

        val gEffective = max(gMaxDbi - (lossAz + lossEl), -20.0)

        val distKm = distance / 1000.0
        val fspl = 20.0 * log10(distKm) + 20.0 * log10(freqMhz) + 32.44

        val rssi = pTxDbm + gEffective - fspl

        return SignalResult(
            distanceMeters = distance,
            targetAzimuthDeg = targetAzDeg,
            targetElevationDeg = targetElDeg,
            deltaAzimuthDeg = deltaAz,
            deltaElevationDeg = deltaEl,
            rssiDbm = rssi
        )
    }
}

data class AntennaState(
    val azimuthDeg: Float = 116f,
    val elevationDeg: Float = 29f,
    val batteryVoltage: Float = 12.4f
)

class AntennaRotatorController(val maxSpeedDegPerSec: Float = 40f) {
    var state by mutableStateOf(AntennaState())
        private set

    fun update(joystickX: Float, joystickY: Float, deltaTimeSeconds: Float) {
        var newAz = state.azimuthDeg + (joystickX * maxSpeedDegPerSec * deltaTimeSeconds)
        var newEl = state.elevationDeg + (joystickY * maxSpeedDegPerSec * deltaTimeSeconds)

        newAz = (newAz + 360f) % 360f
        newEl = newEl.coerceIn(0f, 85f)

        state = state.copy(azimuthDeg = newAz, elevationDeg = newEl)
    }
}

